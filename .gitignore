# Rendered Lightsail deployment spec — contains the runtime secret, never commit.
containers.json

# Node (root dev runner)
node_modules/

# Local runtime configuration. Commit examples only, never real endpoints/keys.
.env
.env.local
.env.*.local
!.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
# Dependencies
**/node_modules/

# Build and test caches
**/.vite/
**/dist/
**/*.tsbuildinfo
**/coverage/

# Local databases
**/*.db
**/*.sqlite
**/*.sqlite3

# Python caches
**/__pycache__/
**/.pytest_cache/