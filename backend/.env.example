# Customer Insight Intelligence - backend environment example
# Copy to .env and adjust as needed. MOCK mode requires no external keys.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./customer_insight.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider selection: mock | bedrock | openai
# Default is mock and works with no credentials.
AI_PROVIDER=mock

# --- OpenAI (only used when AI_PROVIDER=openai) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- AWS Bedrock (only used when AI_PROVIDER=bedrock) ---
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
