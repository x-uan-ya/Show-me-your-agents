# Customer Insight Intelligence - backend environment example
# Copy to .env and adjust as needed. MOCK mode requires no external keys.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./customer_insight.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider selection: mock | hackathon
# Default is mock and works with no credentials (deterministic dev/test output).
AI_PROVIDER=mock

# --- Hackathon provider (only used when AI_PROVIDER=hackathon) ---
# The organiser-provided JSON API is backed by AWS Bedrock (Claude Sonnet 4.5).
# The endpoint, request/response format, and auth scheme will be shared via
# Slack. These names are provisional placeholders until then; the provider
# raises a clear not-implemented error until it is wired up.
# HACKATHON_API_BASE_URL=
# HACKATHON_API_KEY=
