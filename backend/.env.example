# Customer Insight Intelligence - backend environment example
# Copy to .env and adjust as needed. MOCK mode requires no external keys.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./customer_insight.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider selection: mock | hackathon
# Default is mock and works with no credentials (deterministic dev/test output).
AI_PROVIDER=mock

# --- Hackathon provider (only used when AI_PROVIDER=hackathon) ---
# The organiser-provided gateway is an Ollama-native API (POST /api/chat, Bearer
# auth) fronting AWS Bedrock Claude Sonnet 4.5. Copy this file to .env, set
# AI_PROVIDER=hackathon, and fill in the values below. Never commit real keys.
# LLM_GATEWAY_URL=https://api.softwaresystems.app
# LLM_GATEWAY_API_KEY=your-team-api-key
# LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
