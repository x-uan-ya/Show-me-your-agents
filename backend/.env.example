# Customer Insight Intelligence - backend environment example

# Local authentication. This fallback is development-only. Production startup
# requires AUTH_SECRET to be explicitly set to at least 32 random characters.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_SECONDS=28800
# Keep false for localhost HTTP. Production startup requires true.
AUTH_COOKIE_SECURE=false
# Optional: consumed only by `python -m app.scripts.seed_demo_users`.
# DEMO_USER_PASSWORD=set-a-local-demo-password

# Email OTP delivery. `console` prints codes only in the local backend terminal.
# To deliver real email, set EMAIL_DELIVERY=smtp and configure your provider.
EMAIL_DELIVERY=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password-or-app-password
# SMTP_FROM_EMAIL=no-reply@your-domain.com
# SMTP_FROM_NAME=Campaign Intelligence
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# EMAIL_OTP_EXPIRY_MINUTES=10
# EMAIL_OTP_RESEND_SECONDS=60
# EMAIL_OTP_MAX_ATTEMPTS=5
# Copy to .env and adjust as needed. MOCK mode requires no external keys.

# Process-local rate limits. These defaults are enabled in development and
# production. Production refuses RATE_LIMIT_ENABLED=false.
RATE_LIMIT_ENABLED=true
LOGIN_IP_LIMIT=10
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_ACCOUNT_LIMIT=5
LOGIN_ACCOUNT_WINDOW_SECONDS=600
REGISTER_IP_LIMIT=5
REGISTER_IP_WINDOW_SECONDS=3600
REGISTER_EMAIL_LIMIT=3
REGISTER_EMAIL_WINDOW_SECONDS=3600
OTP_EMAIL_LIMIT=5
OTP_EMAIL_WINDOW_SECONDS=3600
OTP_IP_LIMIT=10
OTP_IP_WINDOW_SECONDS=3600
OTP_VERIFY_EMAIL_LIMIT=10
OTP_VERIFY_IP_LIMIT=30
OTP_VERIFY_WINDOW_SECONDS=600
AI_USER_LIMIT=10
AI_WORKSPACE_LIMIT=30
AI_RATE_LIMIT_WINDOW_SECONDS=3600
# Forwarded IP headers are ignored unless the direct socket peer belongs to one
# of these explicitly trusted networks. Leave empty unless the proxy CIDRs have
# been verified for the deployment.
RATE_LIMIT_TRUSTED_PROXY_CIDRS=

ENVIRONMENT=development
DATABASE_URL=sqlite:///./customer_insight.db

# Comma-separated list of allowed frontend origins. Production requires an
# explicit non-empty allowlist and rejects `*`.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider selection: mock | hackathon
# Default is mock and works with no credentials (deterministic dev/test output).
AI_PROVIDER=mock

# Per-request AI input budget. Oversized datasets are rejected before any
# provider call, and concurrent requests for the same dataset return HTTP 409.
ANALYSIS_MAX_SIGNALS=200
ANALYSIS_MAX_INPUT_CHARS=100000

# --- Hackathon provider (only used when AI_PROVIDER=hackathon) ---
# The organiser-provided gateway is an Ollama-native API (POST /api/chat, Bearer
# auth) fronting AWS Bedrock Claude Sonnet 4.5. Copy this file to .env, set
# AI_PROVIDER=hackathon, and fill in the values below. Never commit real keys.
# LLM_GATEWAY_URL=https://api.softwaresystems.app
# LLM_GATEWAY_API_KEY=your-team-api-key
# LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
