# Local development defaults to the Vite /api proxy. Keep the frontend on a
# relative URL so browser requests remain same-origin and avoid CORS issues.
VITE_API_BASE_URL=/api

# Backend origin only (with or without a trailing /api). For the local backend:
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# To trial the local frontend against AWS Lightsail, copy this file to
# .env.local and replace the value above with the public service origin:
# VITE_API_PROXY_TARGET=https://YOUR-SERVICE.ap-southeast-1.cs.amazonlightsail.com
